# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/<db_name>

# Configuración del servidor Flask
FLASK_APP=app.py
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=dev-secret-key-12345

# Autenticación JWT
JWT_SECRET_KEY=cambiar_por_clave_secreta_jwt_de_al_menos_32_bytes
JWT_ALGORITHM=HS256

# 1. Servicio Central de Auditoría (poliza_seguridad)
AUDIT_SERVICE_URL=https://polizaseguridad.vercel.app
AUDIT_API_KEY=AUDIT_API_KEY

# 2. Motor de Fraude (motor_fraude)
FRAUDE_SERVICE_URL=https://motorfraude.vercel.app
FRAUDE_API_KEY=FRAUDE_API_KEY

# 3. Motor de Respuesta a Incidentes (motor_respuesta_incidentes)
RESPUESTA_SERVICE_URL=https://motorrespuestaincidentes.vercel.app
RESPUESTA_API_KEY=RESPUESTA_API_KEY

# Timeout para llamadas a los microservicios
SECURITY_TIMEOUT=10.0
