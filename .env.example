# Cadena de conexión a PostgreSQL
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polizas_db

# Configuración del servidor Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Configuración JWT
JWT_SECRET_KEY=tu_clave_secreta_jwt_aqui
JWT_ALGORITHM=HS256

# Configuración del Servicio de Auditoría
AUDITORIA_SERVICE_URL=http://localhost:5001/api/auditoria/verificar-integridad
AUDITORIA_TIMEOUT=5.0

